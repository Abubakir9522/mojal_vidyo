{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "strict": true, "skipLibCheck": true,
    "jsx": "react-jsx", "jsxImportSource": "preact", "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "noEmit": true, "types": ["vite/client"], "paths": { "react": ["./node_modules/preact/compat"], "react-dom": ["./node_modules/preact/compat"] }
  },
  "include": ["src"]
}
